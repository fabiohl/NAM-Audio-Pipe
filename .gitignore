# Ignore temporary files
*.tmp*
.DS_Store
Thumbs.db
repomix-*.xml
*.bak
*.swp
*.log

# Defense-in-depth: prevent committing nested .git/ metadata from any subdirectory
**/.git/

# Ignore Rust build artifacts
#Cargo.lock
/target

# Ignore scratch directory (debug artifacts and temporary prototypes)
scratch/
scratch
scratch.rs

# Ad-hoc debug binaries and scripts in root
/test_*
!/tests/

# Numerical validation golden vectors (do not ignore)
!tests/fixtures/*.bin

# Ignore extraneous json files but allow test fixtures
*.json
!tests/fixtures/**/*.json

# Proptest regression files (automatically generated)
*.proptest-regressions

# Fuzzing (cargo-fuzz)
# Keep only target definitions and configuration; ignore corpus and crash artifacts.
fuzz/target/
fuzz/artifacts/
fuzz/corpus/
fuzz/Cargo.lock

# cargo-mutants artifacts
.mutants/
.out/
mutants.out.old/

# Build artifacts from C++ render tool
/tests/fixtures/render_ir
/build/

# Temporary files from golden vector generation scripts
/tests/fixtures/.temp_golden/
/tests/fixtures/.temp_live/

# Session WAV recordings (manual testing artifacts)
capture_*.wav

# Python bytecode artifacts (fixture/utility scripts)
__pycache__/
*.pyc

# Local IDE tool artifacts
/.kilo/
