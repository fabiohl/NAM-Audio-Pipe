[Desktop Entry]
Type=Application
Name=NAM Audio Pipe
GenericName=Neural Amp Modeler PipeWire Host
Comment=Low-latency PipeWire standalone host for Neural Amp Modeler (NAM)
Exec=nam-audio-pipe
Icon=io.github.fabiohl.NAMAudioPipe
Terminal=true
Categories=AudioVideo;Audio;ConsoleOnly;
Keywords=audio;dsp;nam;guitar;amp;pipewire;
StartupNotify=false
Actions=RunBypass;Diagnostics;

# F-UX-05: a launcher with no arguments prints the help and exits immediately
# (non-interactive CLI by design). The actions below start the host or pause
# explicitly via --pause (Diagnostics).
[Desktop Action RunBypass]
Name=Run in bypass (no model)
Exec=nam-audio-pipe --gate off

[Desktop Action Diagnostics]
Name=Diagnostics
Exec=nam-audio-pipe --diagnose --pause
